<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FortniteTracker</AssemblyName>
    <UiDir>$(MSBuildProjectDirectory)\..\..\ui</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FortniteTracker.Core\FortniteTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release builds compile the Vue app into wwwroot. Pass -p:SkipUiBuild=true to reuse an existing build. -->
  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And '$(SkipUiBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- Vite hashes asset names, so the file list must be read after the UI build, not at evaluation time. -->
  <Target Name="IncludeUi" AfterTargets="BuildUi" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
