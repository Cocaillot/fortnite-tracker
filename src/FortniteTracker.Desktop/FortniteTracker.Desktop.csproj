<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FortniteTracker</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's hooks before WPF starts. -->
    <StartupObject>FortniteTracker.Desktop.Program</StartupObject>
    <UiDir>$(MSBuildProjectDirectory)\..\..\ui</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings clash with WPF types (Application, MessageBox...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FortniteTracker.Core\FortniteTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml as a Page (not ApplicationDefinition) so WPF doesn't generate a second Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\app.ico" />
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release builds compile the Vue app into wwwroot. Pass -p:SkipUiBuild=true to reuse an existing build. -->
  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And '$(SkipUiBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- Vite hashes asset names, so the file list must be read after the UI build, not at evaluation time. -->
  <Target Name="IncludeUi" AfterTargets="BuildUi" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
