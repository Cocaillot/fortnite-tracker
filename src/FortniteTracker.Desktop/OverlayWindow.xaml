<Window x:Class="FortniteTracker.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Tracker overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Barlow Condensed</FontFamily>
        <!-- Replaced from the app theme in ApplyTheme. -->
        <SolidColorBrush x:Key="Muted" Color="#A9AFBC" />
        <SolidColorBrush x:Key="OverlayText" Color="White" />
        <SolidColorBrush x:Key="OverlayBackground" Color="#E60D0F14" />
        <SolidColorBrush x:Key="OverlayAccent" Color="#4CB8FF" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource OverlayBackground}" BorderBrush="#26FFFFFF" BorderThickness="1"
            Padding="14,10,14,12" MinWidth="230">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="Timer" DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="#5FD86B" />
                <TextBlock x:Name="Header" Style="{StaticResource Label}" Foreground="{DynamicResource OverlayAccent}" Text="FORTNITE TRACKER" />
            </DockPanel>

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
                                       FontSize="13" Foreground="{DynamicResource OverlayText}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="150" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Kd}" Foreground="{Binding KdBrush}"
                                       FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding WinRate}" Foreground="{DynamicResource Muted}"
                                       FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EliminatorPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="0,8,0,0"
                    BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Foreground="#FF6B6B" Text="ELIMINATED BY" />
                    <DockPanel>
                        <TextBlock x:Name="EliminatorKd" DockPanel.Dock="Right" FontFamily="{StaticResource Display}"
                                   FontWeight="ExtraBold" FontSize="20" Margin="12,0,0,0" />
                        <TextBlock x:Name="EliminatorName" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{DynamicResource OverlayText}" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="EliminatorDetail" Style="{StaticResource Label}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
