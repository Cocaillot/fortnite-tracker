<Window x:Class="FortniteTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fortnite Tracker"
        Icon="Assets/app.ico"
        Width="400" Height="680" MinWidth="340" MinHeight="420"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0D12">
    <!-- The Vue UI draws the title bar (see TitleBar.vue); WindowChrome keeps resizing and snapping. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- The margin keeps the edges outside WebView2 so they can still be grabbed for resizing. -->
    <wv2:WebView2 x:Name="WebView" Margin="4" DefaultBackgroundColor="#0B0D12" />
</Window>
