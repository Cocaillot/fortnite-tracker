<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": the project's own binaries, uploaded by
  .github/workflows/release.yml as a GitHub artifact (a zip). Third-party DLLs and the .NET
  runtime ship unsigned-by-us, as allowed by the SignPath Foundation terms.
  Paste this into SignPath → project → Artifact Configurations, with the slug "app".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="FortniteTracker.exe" />
      <include path="FortniteTracker.dll" />
      <include path="FortniteTracker.Core.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
